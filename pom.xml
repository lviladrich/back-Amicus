<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
		 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
		 xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>

	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/>
	</parent>

	<groupId>com.uade</groupId>
	<artifactId>amicus</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>amicus</name>
	<description>Amicus - Marketplace de servicios del hogar</description>

	<properties>
		<java.version>21</java.version>
		<!--
			Lombok genera codigo leyendo estructuras internas del compilador,
			asi que cada version soporta hasta un JDK determinado. La que fija
			Spring Boot 3.5.3 es la 1.18.38, anterior a JDK 24.

			Se sube la version para poder compilar con un JDK reciente. El
			bytecode se sigue generando para Java 21, que es lo que declara
			java.version mas arriba.

			Va de la mano con annotationProcessorPaths, mas abajo en <build>:
			sin esa configuracion el procesador no llega a ejecutarse, por mas
			que la version sea la correcta.
		-->
		<lombok.version>1.18.46</lombok.version>
	</properties>

	<dependencies>
		<!-- Controllers REST, servidor Tomcat embebido, serializacion JSON -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>

		<!-- JPA + Hibernate: mapeo de entidades a tablas y repositorios -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Validacion declarativa con @NotBlank, @Min, @Email, etc. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- Base por defecto: no requiere instalacion -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- Driver para el perfil opcional 'mysql' -->
		<dependency>
			<groupId>com.mysql</groupId>
			<artifactId>mysql-connector-j</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
			Spring Security completo: trae BCrypt (PasswordEncoder) y ademas las
			interfaces UserDetails y UserDetailsService que pide la consigna.

			Al agregarlo, Spring Boot autoconfigura un filtro que exige login en
			todos los endpoints. Eso se desactiva de forma explicita con el bean
			SecurityFilterChain de ConfiguracionSeguridad, que por ahora deja
			pasar todo: la infraestructura queda armada sin bloquear la API.
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>

		<!-- Genera getters, setters y constructores en tiempo de compilacion -->
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>

		<!--
			Swagger / OpenAPI: genera documentacion interactiva de la API
			leyendo los controllers. Disponible en /swagger-ui.html
		-->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>2.8.6</version>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!--
				Declara Lombok como procesador de anotaciones de forma explicita.

				Hasta JDK 22, javac buscaba procesadores en el classpath y los
				ejecutaba solo: alcanzaba con tener el jar de Lombok como
				dependencia. Desde JDK 23 eso dejo de hacerse por defecto, asi
				que el procesador no corre, no se genera ningun getter ni
				builder, y la compilacion falla con decenas de
				"cannot find symbol: builder()" que parecen errores del
				proyecto y no del entorno.

				annotationProcessorPaths le dice a javac exactamente que
				procesadores usar, sin depender de esa busqueda automatica.
				Funciona igual en JDK 21 que en los mas nuevos.
			-->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<configuration>
					<annotationProcessorPaths>
						<path>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
							<version>${lombok.version}</version>
						</path>
					</annotationProcessorPaths>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
				<configuration>
					<excludes>
						<exclude>
							<groupId>org.projectlombok</groupId>
							<artifactId>lombok</artifactId>
						</exclude>
					</excludes>
				</configuration>
			</plugin>
		</plugins>
	</build>

</project>
